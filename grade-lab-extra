#!/usr/bin/env python3
from pathlib import Path
from gradelib import Runner, save, shell_script, test, run_tests

Path("validation").mkdir(exist_ok=True)
r = Runner(save("validation/extra-checks.txt"))


@test(1, "alarm lifecycle, assembly examples, and fork regression")
def extra_checks():
    r.run_qemu(shell_script(["bttest", "alarmcheck", "call", "endian", "forktest"]),
               timeout=90)
    r.match("^alarmcheck: all checks passed$", "^12 13$",
            "^HE110 World$", "^fork test OK$")


run_tests()
